{% extends "layouts/base.njk" %}

{% block title %}{{ jobRole.roleName }}{% endblock %}

{% block masthead %}
	<section class="masthead masthead--compact">
		<div class="shell">
			<span class="section-label">Job role</span>
			<h1 class="display display--page">{{ jobRole.roleName }}</h1>
			<p class="lede">
				{{ jobRole.capability.capabilityName }} in {{ jobRole.location }}.
			</p>
		</div>
	</section>
{% endblock %}

{% block content %}
	{% if query.applied %}
		<div class="auth-form__success" role="status">
			<span class="auth-form__success-icon" aria-hidden="true">&#10003;</span>
			<div>
				<p class="auth-form__success-title">Application submitted!</p>
				<p class="auth-form__success-body">Thank you for applying — we'll be in touch soon.</p>
			</div>
		</div>
	{% endif %}

	{% if query.alreadyApplied %}
		<div class="auth-form__notice" role="status">
			<span class="auth-form__notice-icon" aria-hidden="true">i</span>
			<div>
				<p class="auth-form__notice-title">You've already applied</p>
				<p class="auth-form__notice-body">You can only submit one application per role.</p>
			</div>
		</div>
	{% endif %}

	<article class="job-detail">
		<div class="job-detail__heading">
			<h2 class="display display--section">Role details</h2>
			<span class="job-status job-status--{{ jobRole.status.statusName | lower }}">
				{{ jobRole.status.statusName }}
			</span>
			{% if isAdmin %}
				<a class="button button--outline job-detail__edit-link" href="/jobs/job-roles/{{ jobRole.jobRoleId }}/edit">Edit role</a>
			{% endif %}
		</div>

		<dl class="job-meta">
			<div>
				<dt>Location</dt>
				<dd>{{ jobRole.location }}</dd>
			</div>
			<div>
				<dt>Capability</dt>
				<dd>{{ jobRole.capability.capabilityName }}</dd>
			</div>
			<div>
				<dt>Band</dt>
				<dd>{{ jobRole.band.bandName }}</dd>
			</div>
			<div>
				<dt>Closing date</dt>
				<dd>{{ jobRole.closingDate | truncate(10, true, "") }}</dd>
			</div>
			<div>
				<dt>Open positions</dt>
				<dd>{{ jobRole.numberOfOpenPositions }}</dd>
			</div>
		</dl>

		<div class="job-detail__section">
			<h3>Description</h3>
			<p>{{ jobRole.description }}</p>
		</div>

		<div class="job-detail__section">
			<h3>Responsibilities</h3>
			<p>{{ jobRole.responsibilities }}</p>
		</div>
	</article>

	<div class="job-detail__actions">
		{% if authenticatedUser.role === "user" and jobRole.status.statusName === "Open" and jobRole.numberOfOpenPositions > 0 %}
			<a
				class="button button--solid"
				href="/applications/job-roles/{{ jobRole.jobRoleId }}/apply"
			>
				Apply now
			</a>
		{% endif %}
		<a
			class="button button--solid"
			href="{{ jobRole.sharepointUrl }}"
			target="_blank"
			rel="noopener noreferrer"
		>
			View job spec
		</a>
		<a class="button button--ink" href="{{ backHref }}">Back to all roles</a>
	</div>
{% endblock %}
