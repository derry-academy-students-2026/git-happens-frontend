{% extends "layouts/base.njk" %}

{% block title %}Register{% endblock %}

{% block masthead %}
  <section class="masthead masthead--compact">
    <div class="shell">
      <span class="section-label">Join the team</span>
      <h1 class="display display--page">Create an account</h1>
      <p>Set up your account to access the job roles area.</p>
    </div>
  </section>
{% endblock %}

{% block content %}
  <section class="auth-card" aria-labelledby="register-title">
    <h2 id="register-title" class="display display--section">Create your account</h2>
    <p class="auth-card__intro">Use your work email to get started.</p>

    {% if successMessage %}
      <div class="auth-card__success" role="status">
        {{ successMessage }}
      </div>
    {% endif %}

    {% if errorMessage %}
      <p class="auth-card__error" role="alert">
        <strong>Error:</strong> {{ errorMessage }}
      </p>
    {% endif %}

    <form class="auth-form" method="post" action="/auth/register" novalidate>
      <div class="auth-form__field">
        <label for="email">Email address</label>
        <input
          type="email"
          id="email"
          name="email"
          value="{{ formValues.email }}"
          required
          autocomplete="email"
          aria-describedby="email-hint"
        />
        <small class="auth-form__hint" id="email-hint">We'll use this to sign you in.</small>
      </div>

      <div class="auth-form__field">
        <label for="password">Password</label>
        <input
          type="password"
          id="password"
          name="password"
          required
          autocomplete="new-password"
          aria-describedby="password-hint"
        />
        <small class="auth-form__hint" id="password-hint">
          Must be more than 8 characters with uppercase, lowercase, and special character.
        </small>
      </div>

      <div class="auth-form__field">
        <label for="confirmPassword">Confirm password</label>
        <input
          type="password"
          id="confirmPassword"
          name="confirmPassword"
          required
          autocomplete="new-password"
          aria-describedby="confirm-password-hint"
        />
        <small class="auth-form__hint" id="confirm-password-hint">Must match your password.</small>
      </div>

      <button type="submit" class="button button--ink">Create account</button>
    </form>

    <p class="auth-card__footer">
      Already have an account?
      <a href="/auth/login">Log in</a>
    </p>
  </section>
{% endblock %}
