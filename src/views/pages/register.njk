{% extends "layouts/base.njk" %}

{% block title %}Register{% endblock %}

{% block content %}
  <div class="auth-container">
    <h1 class="display display--page">Create an Account</h1>

    {% if successMessage %}
      <div class="success-message" role="status">
        <strong>Success:</strong> {{ successMessage }}
        {% if registeredUser %}
          <p>
            Registered {{ registeredUser.email }} as {{ registeredUser.role }} on
            {{ registeredUser.createdAt }}.
          </p>
        {% endif %}
      </div>
    {% endif %}
    
    {% if errorMessage %}
      <div class="error-message" role="alert">
        <strong>Error:</strong> {{ errorMessage }}
      </div>
    {% endif %}

    <form method="post" action="/auth/register" novalidate>
      <div class="form-group">
        <label for="email">Email Address</label>
        <input
          type="email"
          id="email"
          name="email"
          value="{{ formValues.email }}"
          required
          autocomplete="email"
          aria-describedby="email-hint"
        />
        <small id="email-hint">We'll use this to sign you in</small>
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input
          type="password"
          id="password"
          name="password"
          required
          autocomplete="new-password"
          aria-describedby="password-hint"
        />
        <small id="password-hint">
          Must be more than 8 characters with uppercase, lowercase, and special
          character
        </small>
      </div>

      <div class="form-group">
        <label for="confirmPassword">Confirm Password</label>
        <input
          type="password"
          id="confirmPassword"
          name="confirmPassword"
          required
          autocomplete="new-password"
          aria-describedby="confirm-password-hint"
        />
        <small id="confirm-password-hint">Must match your password</small>
      </div>

      <button type="submit" class="button button--solid">Create Account</button>
    </form>

    <p class="auth-footer">Use your new account to continue in the backend system.</p>
  </div>
{% endblock %}
