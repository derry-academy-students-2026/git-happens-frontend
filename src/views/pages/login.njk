{% extends "layouts/base.njk" %}

{% block title %}Login{% endblock %}

{% block masthead %}
	<section class="masthead masthead--compact">
		<div class="shell">
			<span class="section-label">Access your account</span>
			<h1 class="display display--page">Login</h1>
			<p>Sign in to continue to the job roles area.</p>
		</div>
	</section>
{% endblock %}

{% block content %}
	<section class="auth-card" aria-labelledby="login-title">
		<h2 id="login-title" class="display display--section">Welcome back</h2>
		<p class="auth-card__intro">Use your email and password to continue.</p>

		{% if error %}
			<p class="auth-card__error" role="alert">{{ error }}</p>
		{% endif %}

		{% if success %}
			<div class="auth-card__success" role="status">{{ success }}</div>
		{% endif %}

		<form class="auth-form" action="/auth/login" method="post">
			<input type="hidden" name="returnTo" value="{{ returnTo }}" />

			<div class="auth-form__field">
				<label for="email">Email</label>
				<input
					id="email"
					name="email"
					type="email"
					autocomplete="email"
					required
					value="{{ email }}"
				/>
			</div>

			<div class="auth-form__field">
				<label for="password">Password</label>
				<input
					id="password"
					name="password"
					type="password"
					autocomplete="current-password"
					required
				/>
			</div>

			<button class="button button--ink" type="submit">Login</button>
		</form>

		<p class="auth-card__footer">
			New here?
			<a href="/auth/register">Create an account</a>
		</p>
	</section>
{% endblock %}