{% extends "layouts/base.njk" %}{% block title %}Add a job role{% endblock %}{%
  block masthead
%}
  <section class="masthead masthead--compact">
    <div class="shell">
      <span class="section-label">Admin</span>
      <h1 class="display display--page">Add a job role</h1>
      <p class="lede">
        Create a role against an existing capability and band. New roles open
        straight away.
      </p>
    </div>
  </section>{% endblock %}{% block content %}
  <section
    class="form-card"
    aria-labelledby="add-role-title">
    <h2
      id="add-role-title"
      class="display display--section">
      Role details
    </h2>
    <p class="form-card__intro">Every field is required.</p>
    {% if errorMessage %}
      <p
        class="form-error-summary"
        role="alert">
        {{ errorMessage }}
      </p>
    {% endif %}
    <form
      class="role-form"
      method="post"
      action="/jobs/job-roles"
      novalidate>
      <div class="role-form__row">
        <div
          class="role-form__field {% if errors.roleName %}role-form__field--invalid{% endif %}">
          <label for="roleName">Role name</label> <input
            type="text"
            id="roleName"
            name="roleName"
            value="{{ formValues.roleName }}"
            {% if errors.roleName %}
              aria-invalid="true"
              aria-describedby="roleName-error"
            {% endif %}
          /> {% if errors.roleName %}
            <span
              class="role-form__error"
              id="roleName-error"><span class="sr-only">Error: </span>{{ errors.roleName }}</span>
          {% endif %}
        </div>
        <div
          class="role-form__field {% if errors.location %}role-form__field--invalid{% endif %}">
          <label for="location">Location</label> <input
            type="text"
            id="location"
            name="location"
            value="{{ formValues.location }}"
            {% if errors.location %}
              aria-invalid="true"
              aria-describedby="location-error"
            {% endif %}
          /> {% if errors.location %}
            <span
              class="role-form__error"
              id="location-error"><span class="sr-only">Error: </span>{{ errors.location }}</span>
          {% endif %}
        </div>
      </div>
      <div class="role-form__row">
        <div
          class="role-form__field {% if errors.capabilityId %}role-form__field--invalid{% endif %}">
          <label for="capabilityId">Capability</label>
          <select
            id="capabilityId"
            name="capabilityId"
            {% if errors.capabilityId %}
              aria-invalid="true"
              aria-describedby="capabilityId-error"
            {% endif %}>
            <option value="">Select a capability</option>
            {% for capability in capabilities %}
              <option
                value="{{ capability.capabilityId }}"
                {%
                  if formValues.capabilityId == capability.capabilityId | string
                %}
                  selected
                {% endif %}>
                {{ capability.capabilityName }}
              </option>
            {% endfor %}
          </select>
          {% if errors.capabilityId %}
            <span
              class="role-form__error"
              id="capabilityId-error"><span class="sr-only">Error: </span>{{ errors.capabilityId }}</span>
          {% endif %}
        </div>
        <div
          class="role-form__field {% if errors.bandId %}role-form__field--invalid{% endif %}">
          <label for="bandId">Band</label>
          <select
            id="bandId"
            name="bandId"
            {% if errors.bandId %}
              aria-invalid="true"
              aria-describedby="bandId-error"
            {% endif %}>
            <option value="">Select a band</option>
            {% for band in bands %}
              <option
                value="{{ band.bandId }}"
                {% if formValues.bandId == band.bandId | string %}
                  selected
                {% endif %}>
                {{ band.bandName }}
              </option>
            {% endfor %}
          </select>
          {% if errors.bandId %}
            <span
              class="role-form__error"
              id="bandId-error"><span class="sr-only">Error: </span>{{ errors.bandId }}</span>
          {% endif %}
        </div>
      </div>
      <div class="role-form__row">
        <div
          class="role-form__field {% if errors.closingDate %}role-form__field--invalid{% endif %}">
          <label for="closingDate">Closing date</label> <input
            type="date"
            id="closingDate"
            name="closingDate"
            value="{{ formValues.closingDate }}"
            min="{{ todayIsoDate }}"
            {% if errors.closingDate %}
              aria-invalid="true"
              aria-describedby="closingDate-error"
            {% endif %}
          /> {% if errors.closingDate %}
            <span
              class="role-form__error"
              id="closingDate-error"><span class="sr-only">Error: </span>{{ errors.closingDate }}</span>
          {% endif %}
        </div>
        <div
          class="role-form__field {% if errors.numberOfOpenPositions %}role-form__field--invalid{% endif %}">
          <label for="numberOfOpenPositions">Open positions</label> <input
            type="number"
            id="numberOfOpenPositions"
            name="numberOfOpenPositions"
            min="1"
            step="1"
            value="{{ formValues.numberOfOpenPositions }}"
            aria-describedby="positions-hint{% if errors.numberOfOpenPositions %} numberOfOpenPositions-error{% endif %}"
            {% if errors.numberOfOpenPositions %}aria-invalid="true"{% endif %}
          /> <small
            class="role-form__hint"
            id="positions-hint">How many people you are hiring for this
            role.</small> {% if errors.numberOfOpenPositions %}
            <span
              class="role-form__error"
              id="numberOfOpenPositions-error"><span class="sr-only">Error: </span>{{
              errors.numberOfOpenPositions
            }}</span>
          {% endif %}
        </div>
      </div>
      <div
        class="role-form__field {% if errors.description %}role-form__field--invalid{% endif %}">
        <label for="description">Description</label> <textarea
          id="description"
          name="description"
          rows="5"
          {% if errors.description %}
            aria-invalid="true"
            aria-describedby="description-error"
          {% endif %}>{{ formValues.description }}</textarea> {%
          if errors.description
        %}
          <span
            class="role-form__error"
            id="description-error"><span class="sr-only">Error: </span>{{ errors.description }}</span>
        {% endif %}
      </div>
      <div
        class="role-form__field {% if errors.responsibilities %}role-form__field--invalid{% endif %}">
        <label for="responsibilities">Responsibilities</label> <textarea
          id="responsibilities"
          name="responsibilities"
          rows="5"
          {% if errors.responsibilities %}
            aria-invalid="true"
            aria-describedby="responsibilities-error"
          {% endif %}>{{ formValues.responsibilities }}</textarea> {%
          if errors.responsibilities
        %}
          <span
            class="role-form__error"
            id="responsibilities-error"><span class="sr-only">Error: </span>{{ errors.responsibilities }}</span>
        {% endif %}
      </div>
      <div class="role-form__actions">
        <button
          type="submit"
          class="button button--ink">
          Create job role
        </button> <a
          class="button button--outline"
          href="/jobs/job-roles">Cancel</a>
      </div>
    </form>
  </section>{% endblock %}
