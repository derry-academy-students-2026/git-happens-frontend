{% extends "layouts/base.njk" %}

{% block title %}Something went wrong{% endblock %}

{% block masthead %}
	<section class="masthead masthead--compact">
		<div class="shell">
			<span class="section-label">Careers at Kainos</span>
			<h1 class="display display--page">Something went wrong</h1>
		</div>
	</section>
{% endblock %}

{% block content %}
	<div class="notice">
		<h2>We could not load that page</h2>
		<p>{{ error | default("An unexpected error occurred. Please try again.") }}</p>
		<a class="button button--ink" href="/jobs/job-roles">Back to job roles</a>
	</div>
{% endblock %}
