<div class="results-bar">
	<h2 class="display display--section">All roles</h2>
	<div class="results-bar__actions">
		<span class="results-bar__count">{{ jobRoles | length }} role{% if jobRoles | length != 1 %}s{% endif %}</span>
		{% if isAdmin %}
			<a class="button button--ink" href="/jobs/job-roles/new">Add a job role</a>
		{% endif %}
	</div>
</div>

{% if jobRoles | length %}
	<ul class="job-list">
		{% for jobRole in jobRoles %}
			<li>
				<a class="job-item" href="/jobs/job-roles/{{ jobRole.jobRoleId }}">
					<div class="job-item__heading">
						<h3 class="job-item__title">{{ jobRole.roleName }}</h3>
						<span class="job-status job-status--{{ jobRole.status.statusName | lower }}">
							{{ jobRole.status.statusName }}
						</span>
					</div>

					<dl class="job-meta">
						<div>
							<dt>Location</dt>
							<dd>{{ jobRole.location }}</dd>
						</div>
						<div>
							<dt>Capability</dt>
							<dd>{{ jobRole.capability.capabilityName }}</dd>
						</div>
						<div>
							<dt>Band</dt>
							<dd>{{ jobRole.band.bandName }}</dd>
						</div>
						<div>
							<dt>Closing date</dt>
							<dd>{{ jobRole.closingDate | truncate(10, true, "") }}</dd>
						</div>
					</dl>
				</a>
			</li>
		{% endfor %}
	</ul>
{% else %}
	<p class="empty-state">There are no job roles to show right now.</p>
{% endif %}
