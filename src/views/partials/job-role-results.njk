<div class="results-bar">
	<h2 class="display display--section">All roles</h2>
	<div class="results-bar__actions">
		<span class="results-bar__count">{{ pagination.totalCount }} role{% if pagination.totalCount != 1 %}s{% endif %}</span>
		{% if isAdmin %}
			<a class="button button--ink" href="/jobs/job-roles/new">Add a job role</a>
		{% endif %}
	</div>
</div>

{% if jobRoles | length %}
	<ul class="job-list">
		{% for jobRole in jobRoles %}
			<li>
				<div class="job-list__item">
				<a
					class="job-item"
					href="/jobs/job-roles/{{ jobRole.jobRoleId }}{% if pagination.page > 1 %}?page={{ pagination.page }}{% endif %}"
				>
					<div class="job-item__heading">
						<h3 class="job-item__title">{{ jobRole.roleName }}</h3>
						<span class="job-status job-status--{{ jobRole.status.statusName | lower }}">
							{{ jobRole.status.statusName }}
						</span>
					</div>

					<dl class="job-meta">
						<div>
							<dt>Location</dt>
							<dd>{{ jobRole.location }}</dd>
						</div>
						<div>
							<dt>Capability</dt>
							<dd>{{ jobRole.capability.capabilityName }}</dd>
						</div>
						<div>
							<dt>Band</dt>
							<dd>{{ jobRole.band.bandName }}</dd>
						</div>
						<div>
							<dt>Closing date</dt>
							<dd>{{ jobRole.closingDate | truncate(10, true, "") }}</dd>
						</div>
					</dl>
					</a>
					{% if isAdmin %}
						<a class="button button--outline" href="/jobs/job-roles/{{ jobRole.jobRoleId }}/edit">Edit</a>
					{% endif %}
				</div>
			</li>
		{% endfor %}
	</ul>
{% else %}
	<p class="empty-state">There are no job roles to show right now.</p>
{% endif %}

{% if pagination.totalPages > 1 %}
	<nav class="pagination" aria-label="Job role pages">
		{% if pagination.page > 1 %}
			<a class="pagination__link" href="/jobs/job-roles">First</a>
			<a class="pagination__link" href="/jobs/job-roles?page={{ pagination.page - 1 }}">Previous</a>
		{% else %}
			<span class="pagination__link pagination__link--disabled" aria-disabled="true">First</span>
			<span class="pagination__link pagination__link--disabled" aria-disabled="true">Previous</span>
		{% endif %}

		<span class="pagination__status">Page {{ pagination.page }} of {{ pagination.totalPages }}</span>

		{% if pagination.page < pagination.totalPages %}
			<a class="pagination__link" href="/jobs/job-roles?page={{ pagination.page + 1 }}">Next</a>
			<a class="pagination__link" href="/jobs/job-roles?page={{ pagination.totalPages }}">Last</a>
		{% else %}
			<span class="pagination__link pagination__link--disabled" aria-disabled="true">Next</span>
			<span class="pagination__link pagination__link--disabled" aria-disabled="true">Last</span>
		{% endif %}
	</nav>
{% endif %}
