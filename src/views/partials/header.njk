<header class="site-header">
	<div class="site-header__inner shell">
		<a class="site-header__brand" href="/jobs">
			<img
				class="site-header__logo"
				src="/images/kainos-logo.png"
				alt="Kainos"
				width="800"
				height="250"
			/>
			<span class="site-header__context">Careers</span>
		</a>

		<nav class="site-nav" aria-label="Main">
			<a href="/jobs" {% if currentPath == "/jobs" %}aria-current="page"{% endif %}>Home</a>
			<a href="/jobs/job-roles" {% if currentPath == "/jobs/job-roles" %}aria-current="page"{% endif %}>Job roles</a>
			{% if isAuthenticated %}
				<form action="/auth/logout" method="post" class="site-nav__logout-form">
					<button type="submit" class="site-nav__logout">Log out</button>
				</form>
			{% else %}
				<a href="/auth/login" {% if currentPath == "/auth/login" %}aria-current="page"{% endif %}>Login</a>
			{% endif %}
		</nav>
	</div>
</header>
