# Copy to .env and adjust for your machine.

# Port the frontend server listens on
PORT=3000

# Base URL of the backend job roles API
API_BASE_URL=http://localhost:4000

# How long to wait on the backend API before giving up, in milliseconds
API_TIMEOUT_MS=5000

# development enables debug logging; anything else logs warnings and errors only
NODE_ENV=development

# Overrides the Winston log level (error, warn, info, http, debug)
LOG_LEVEL=debug

# Cache-Control max-age for files in src/public. Use 0 while working on CSS.
STATIC_MAX_AGE=0
